# Application
ENVIRONMENT=production
APP_VERSION=1.1.0
CASE_ID=sao-paulo-dropout
DEBUG=false
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1

# --- OpenRouter (recommended) ---
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your-openrouter-key-here
OPENAI_MODEL=openai/gpt-4o-mini

# --- Or use OpenAI directly ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your-openai-key-here
# OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=90
OPENAI_MAX_RETRIES=2

# Security (required in production)
EXPORT_API_KEY=change-this-to-a-long-random-secret
CORS_ORIGINS=https://perspective-lab.onrender.com
ALLOWED_HOSTS=perspective-lab.onrender.com,localhost

# Absolute URL used in invite links (guest phones/laptops)
PUBLIC_APP_URL=https://perspective-lab.onrender.com

# User accounts (lab colleagues use their own API keys)
AUTH_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@perspectivelab.local
ADMIN_PASSWORD=change-me-admin-password
AUTH_REQUIRED=true

# Rate limiting
RATE_LIMIT_ASK=10/minute

# Database (optional — defaults to backend/data/sessions.db)
# DATABASE_PATH=/app/backend/data/sessions.db
# Production on Render: use Postgres so accounts survive redeploys
# DATABASE_URL=postgresql://user:pass@host/dbname
