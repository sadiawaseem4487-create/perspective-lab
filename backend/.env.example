# --- OpenRouter (recommended) ---
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your-openrouter-key-here
OPENAI_MODEL=openai/gpt-4o-mini

# --- Or use OpenAI directly ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your-openai-key-here
# OPENAI_MODEL=gpt-4o-mini

# Case pack (folder under cases/)
# CASE_ID=sao-paulo-dropout
# CASE_ID=digital-inclusion

ENVIRONMENT=development
EXPORT_API_KEY=
# Optional: auto-run LLM theory fidelity judge during agent self-check (costs extra tokens)
THEORY_JUDGE_LLM=false
CORS_ORIGINS=*
ALLOWED_HOSTS=*

# --- Auth (user accounts / SaaS) ---
# Local open mode: AUTH_REQUIRED=false
# Production (Render): ENVIRONMENT=production → login always required
AUTH_REQUIRED=false
AUTH_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@perspectivelab.local
ADMIN_PASSWORD=admin-change-me
# PUBLIC_APP_URL=https://perspective-lab.onrender.com
